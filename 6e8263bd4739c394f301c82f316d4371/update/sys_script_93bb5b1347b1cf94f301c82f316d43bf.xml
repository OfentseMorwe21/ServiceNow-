        <script><![CDATA[(function executeRule(current, previous) {
    var utils = new OnboardingUtils();
    
    // Get category from catalog item name
    var catalogItemName = current.cat_item.getDisplayValue();
    var category = '';
    
    if (catalogItemName.indexOf('Equipment') > -1) {
        category = 'Equipment';
    } else if (catalogItemName.indexOf('Access') > -1 || 
               catalogItemName.indexOf('Permission') > -1) {
        category = 'Access';
    } else {
        category = 'General';
    }
    
    // Get assignment group sys_id
    var groupSysId = utils.getAssignmentGroup(category);
    
    if (groupSysId) {
        current.assignment_group = groupSysId;
    }

})(current, previous);]]></script>
