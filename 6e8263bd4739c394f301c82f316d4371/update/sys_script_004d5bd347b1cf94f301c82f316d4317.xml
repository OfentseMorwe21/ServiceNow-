        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var catalogItemName = current.item.getDisplayValue();
	var daysToAdd = 3; // Default fallback for everything else

	// Check the item to determine business days SLA allocation
	if (catalogItemName.indexOf("Equipment") > -1) {
		daysToAdd = 5;
	} else if (catalogItemName.indexOf("Access") > -1) {
		daysToAdd = 2;
	}

	// Calculate date using GlideDateTime
	var gdt = new GlideDateTime();
	
	// Simple schedule-skipping loop to count only Monday - Friday
	var addedDays = 0;
	while (addedDays < daysToAdd) {
		gdt.addDaysLocalTime(1);
		var dayOfWeek = gdt.getDayOfWeekLocalTime();
		if (dayOfWeek != 6 && dayOfWeek != 7) { // 6 is Saturday, 7 is Sunday
			addedDays++;
		}
	}

	// Use a clean background update to commit the calculated due date
	var grItem = new GlideRecord('sc_req_item');
	if (grItem.get(current.getUniqueValue())) {
		grItem.setValue('due_date', gdt.getValue());
		grItem.setWorkflow(false); // Prevents looping business rules
		grItem.update();
	}

})(current, previous);]]></script>
