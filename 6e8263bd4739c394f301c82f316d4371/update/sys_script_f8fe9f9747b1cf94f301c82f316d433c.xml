        <script><![CDATA[(function executeRule(current, previous) {

    var email = current.request.requested_for.email;
    
    if (email) {
        var reqNumber = current.number;
        var state = current.state.getDisplayValue();
        
        var portalLink = 'https://' + gs.getProperty('instance_name') + 
            '.service-now.com/onboarding?id=ticket&table=sc_req_item&sys_id=' + 
            current.sys_id;
        
        var subject = "Update on your Onboarding Request: " + reqNumber;
        var body = "Hello,\n\n" +
            "Your request " + reqNumber + 
            " has been updated to: " + state + ".\n\n" +
            "You can view your request here: " + portalLink + "\n\n" +
            "Thank you,\nIT Onboarding Team";
        
        gs.sendEmail(email, subject, body);
    }

})(current, previous);]]></script>
