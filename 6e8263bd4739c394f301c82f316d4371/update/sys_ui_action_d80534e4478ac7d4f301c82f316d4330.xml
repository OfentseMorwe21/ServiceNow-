        <order>100</order>
        <script><![CDATA[// Client side execution
function onClickReject() {
    var reason = prompt('Please enter a rejection reason:'); // Standard prompt
    
    // If user clicks cancel
    if (reason === null) {
        return;
    }
    
    // If user clicks OK but left it blank
    if (reason.trim() === '') {
        g_form.addErrorMessage('A rejection reason is required to reject this request.');
        return;
    }
    
    // Set the value on the form and trigger the server block
    g_form.setValue('u_rejection_reason', reason);
    gsftSubmit(null, g_form.getFormElement(), 'reject_with_reason');
}

// Server side execution (Runs only after gsftSubmit is triggered successfully)
if (typeof window == 'undefined') {
    runServerCode();
}

function runServerCode() {
    current.approval = 'rejected'; // Set approval status to Rejected
    current.stage = 'request_cancelled'; // Optional: update the stage cleanly
    current.state = 4; // Closed Incomplete / Rejected state
    current.update();
    
    // Keep the user on the exact same RITM record page instead of sending them to a new blank form
    action.setRedirectURL(current);
}]]></script>
